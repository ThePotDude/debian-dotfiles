// ~/.config/fastfetch/config.jsonc
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
	"type": "small",
        "source": "Debian",
        "padding": {
            "top": 2,
            "left": 2,
            "right": 3
        }
    },

    "display": {
        "separator": "  ",
        "color": {
            "keys": "31"
        }
    },

    "modules": [
        {
            "type": "title",
            "key": "",
            "format": "{user-name-colored}@{host-name-colored}"
        },
        {
            "type": "os",
            "key": "󰻀",
            "keyColor": "red",
            "format": "{name} {version-id}"
        },
        {
            "type": "kernel",
            "key": "",
            "keyColor": "red"
        },
        {
            "type": "command",
            "key": "",
            "keyColor": "red",
            "text": "birth=$(stat -c %W / 2>/dev/null); if [ -z \"$birth\" ] || [ \"$birth\" = 0 ]; then birth=$(stat -c %W /lost+found 2>/dev/null); fi; if [ -n \"$birth\" ] && [ \"$birth\" != 0 ]; then days=$(( ( $(date +%s) - birth ) / 86400 )); echo \"${days} days\"; else echo 'unknown (fs has no birth time)'; fi"
        },
        {
            "type": "uptime",
            "key": "󱎫",
            "keyColor": "red"
        },
        {
            "type": "packages",
            "key": "󰏓",
            "keyColor": "red"
        },
        {
            "type": "wm",
            "key": "󰖯",
            "keyColor": "red"
        },
        {
            "type": "shell",
            "key": "",
            "keyColor": "red"
        },
        {
            "type": "cpu",
            "key": "",
            "keyColor": "red",
            "format": "{name} ({cores-physical}c/{cores-logical}t)"
        },
        {
            "type": "gpu",
            "key": "󰊖",
            "keyColor": "red"
        },
        {
            "type": "memory",
            "key": "",
            "keyColor": "red"
        },
        {
            "type": "swap",
            "key": "󰯍",
            "keyColor": "red"
        },
        {
            "type": "disk",
            "key": "󱛟",
            "keyColor": "red",
            "folders": "/"
        },
        {
            "type": "colors",
            "symbol": "circle"
        }
    ]
}
